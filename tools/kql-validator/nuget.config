<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Microsoft.Azure.Sentinel.KustoServices is not on nuget.org; it ships inside Azure/Azure-Sentinel.
         tools/validator/fetch-schemas.sh copies it here. -->
    <add key="local" value=".packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
